# Copy to .env and replace every <CHANGE_ME>. Never commit .env.
# Copia a .env y sustituye cada <CHANGE_ME>. Nunca versiones .env.
# Generate passwords with / Genera contraseñas con: openssl rand -base64 32

# Public domain (automatic HTTPS) or http://localhost for local tests.
# Dominio público (HTTPS automático) o http://localhost para pruebas locales.
DOMAIN=http://localhost

# MySQL
MYSQL_ROOT_PASSWORD=<CHANGE_ME>
MYSQL_DATABASE=py4web
MYSQL_USER=py4web
MYSQL_PASSWORD=<CHANGE_ME>

# py4web
PY4WEB_WORKERS=2
# none | readonly | full. Anything but "none" requires a password.
# none | readonly | full. Cualquier valor distinto de "none" exige contraseña.
PY4WEB_DASHBOARD_MODE=none
PY4WEB_DASHBOARD_PASSWORD=

# Enable Fail2Ban on Linux servers (needs iptables on the host).
# Activa Fail2Ban en servidores Linux (requiere iptables en el host).
#COMPOSE_PROFILES=fail2ban
TZ=UTC
